.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.venv/
.venv_docx/
.env

# Large data objects are downloaded, not versioned
data/raw/*.h5ad
data/processed/*.h5ad
data/processed/*.csv
data/processed/*.json
data/processed/*.npz

# Experiment outputs
results/tables/*.csv
results/tables/*.json
results/figures/*.png
results/figures/*.pdf
results/embeddings/*
results/logs/*
results/models/*
results/perturbations/*.npz
!data/raw/.gitkeep
!data/processed/.gitkeep
!results/tables/.gitkeep
!results/figures/.gitkeep
!results/embeddings/.gitkeep
!results/logs/.gitkeep
!results/models/.gitkeep
!results/perturbations/.gitkeep

# Heavy phase artifacts (keep reports/tables/figures/logs; exclude binaries)
results/**/embeddings/
results/**/posterior/
results/**/processed/
results/**/models/
results/**/raw_audit/
results/**/probabilities/
*.npz
*.h5ad
*.pt
*.pth
*.ckpt
*.Rds
*.rds
*.mtx
*.h5
*.pkl
*.pickle

# Office lock / temp files
~$*
*.tmp

# local analysis env for revision round 2
.venv_rev2/

# local python-docx install for manuscript build
.deps_docx/
